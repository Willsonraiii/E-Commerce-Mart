# ── Server ───────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production

# ── Security (CHANGE BOTH BEFORE LAUNCH) ─────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this later signs everyone out; it does NOT delete any data.
JWT_SECRET=replace-with-a-long-random-string
COOKIE_NAME=ym_session

# Used only the first time the database is created.
ADMIN_EMAIL=admin@yalambermart.com.np
ADMIN_PASSWORD=replace-with-a-strong-password

# ── Data ─────────────────────────────────────────────────────────────
# Your entire shop lives in this one file: products, orders, customers,
# reviews, carts. Relative paths resolve from the project root.
# On hosts with ephemeral disks (Render/Railway/Fly/Heroku) point this at
# a MOUNTED VOLUME or it is wiped on every redeploy:
#   DB_FILE=/var/data/yalamber.db
DB_FILE=server/data/yalamber.db

# Admin-uploaded product photos. Put this on the mounted disk too.
#   UPLOAD_DIR=/var/data/uploads
UPLOAD_DIR=public/uploads

# Only needed when the site and API are on DIFFERENT domains (e.g. site on
# Vercel, API on Render). Set it to the site's exact origin — browsers refuse
# credentialed cross-site requests otherwise. Comma-separate several.
#   CORS_ORIGIN=https://yalambar.vercel.app
CORS_ORIGIN=

# ── Frontend ─────────────────────────────────────────────────────────
# Shows one-tap demo credential chips on the sign-in page.
# MUST be false for a real launch — it publishes a working admin login.
VITE_SHOW_DEMO_LOGINS=false
